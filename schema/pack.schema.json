{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/germoroney-iog/trainingai/schema/pack.schema.json",
  "title": "Use-case training pack",
  "description": "Maps one use case to the capabilities it needs and to training records in data/trainings.json. See docs/PACKS.md.",
  "type": "object",
  "required": ["id", "title", "use_case", "outcome", "created_on", "updated_on", "capabilities", "history"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Stable id; must match the file name." },
    "title": { "type": "string", "minLength": 1 },
    "use_case": { "type": "string", "minLength": 1, "description": "The use case in the user's own words." },
    "outcome": { "type": "string", "minLength": 1, "description": "What you will be able to build or do at the end." },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_on": { "$ref": "#/$defs/date" },
    "updated_on": { "$ref": "#/$defs/date" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "why", "steps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1, "description": "Why the use case needs this capability." },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "why"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "description": "A record id in data/trainings.json." },
                "why": { "type": "string", "minLength": 1 },
                "optional": { "type": "boolean" },
                "extra_costs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["description", "amount", "currency"],
                    "additionalProperties": false,
                    "properties": {
                      "description": { "type": "string", "minLength": 1 },
                      "amount": { "type": "number", "minimum": 0 },
                      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                    }
                  }
                }
              }
            }
          },
          "gap": { "type": "string", "minLength": 1, "description": "What no verified course covers yet. Required when steps is empty." }
        },
        "if": { "properties": { "steps": { "maxItems": 0 } } },
        "then": { "required": ["gap"] }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "after_capabilities", "deliverable"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "after_capabilities": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "deliverable": { "type": "string", "minLength": 1 }
        }
      }
    },
    "research_queue": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "change"],
        "additionalProperties": false,
        "properties": { "date": { "$ref": "#/$defs/date" }, "change": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
}
