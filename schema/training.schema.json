{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/germoroney-iog/trainingai/schema/training.schema.json",
  "title": "AI training database",
  "description": "Authoritative database of AI training offerings. See docs/SCHEMA.md for field guidance. Generated views live in catalogue/ and must never be edited by hand.",
  "type": "object",
  "required": ["schema_version", "updated_on", "fx", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "updated_on": { "$ref": "#/$defs/date" },
    "fx": {
      "description": "Exchange rates used for approximate EUR costs. Rates are units of foreign currency per 1 EUR.",
      "type": "object",
      "required": ["source", "source_url", "rate_date", "rates"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "rate_date": { "$ref": "#/$defs/date" },
        "rates": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "missing": {
      "description": "Explicit missing-value states. Never guess a value.",
      "enum": ["not published", "not verified", "not applicable"]
    },
    "text_or_missing": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/missing" }]
    },
    "number_or_missing": {
      "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/missing" }]
    },
    "string_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "provider", "platform", "official_url", "offering_type",
        "categories", "audience", "level", "prerequisites", "learning_outcomes",
        "practical_work", "assessment", "credential", "delivery", "ireland_access",
        "pricing", "learner_rating", "rating_class", "quality_evidence", "limitations",
        "relevance", "suitability", "status", "sources", "verification", "user", "history"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier. Never change or reuse it, even after archiving.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1, "description": "Organisation that designs and teaches the offering." },
        "platform": { "type": "string", "minLength": 1, "description": "Where the offering is delivered (e.g. Coursera, provider's own site)." },
        "official_url": { "type": "string", "format": "uri" },
        "offering_type": {
          "enum": [
            "university-programme", "executive-education", "professional-certification",
            "specialization", "course", "short-course", "workshop", "learning-path"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "strategy-operating-models", "governance-regulation-risk", "security",
              "generative-ai-agents", "python-data", "machine-learning-deep-learning",
              "rag-evals-llmops", "cloud-platforms", "sales-marketing-partnerships"
            ]
          }
        },
        "audience": { "type": "string", "minLength": 1 },
        "level": {
          "enum": [
            "introductory", "introductory-to-intermediate", "intermediate",
            "intermediate-to-advanced", "advanced"
          ]
        },
        "prerequisites": { "$ref": "#/$defs/string_list", "description": "Empty list means the provider states no prerequisites." },
        "learning_outcomes": { "$ref": "#/$defs/string_list", "minItems": 1 },
        "practical_work": { "$ref": "#/$defs/string_list", "description": "Hands-on projects or labs. Empty list means none advertised." },
        "assessment": {
          "type": "object",
          "required": ["type", "description"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none", "auto-graded-quizzes", "graded-assignments", "peer-reviewed",
                "proctored-exam", "capstone-project", "academic-assessment", "mixed", "not verified"
              ]
            },
            "description": { "$ref": "#/$defs/text_or_missing" }
          }
        },
        "credential": {
          "type": "object",
          "required": ["type", "issuer", "academic_credit", "renewal"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "Assessed qualifications and certifications are distinct from completion and attendance certificates.",
              "enum": [
                "assessed-academic-qualification", "professional-certification",
                "assessed-completion-certificate", "completion-certificate",
                "attendance-certificate", "digital-badge", "none", "not verified"
              ]
            },
            "issuer": { "$ref": "#/$defs/text_or_missing" },
            "academic_credit": { "$ref": "#/$defs/text_or_missing" },
            "renewal": { "$ref": "#/$defs/text_or_missing" }
          }
        },
        "delivery": {
          "type": "object",
          "required": ["format", "duration", "study_hours", "access_period", "start_dates"],
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["self-paced-online", "live-online", "cohort-online", "blended", "in-person"] },
            "duration": { "$ref": "#/$defs/text_or_missing" },
            "study_hours": {
              "type": "object",
              "required": ["min", "max", "basis"],
              "additionalProperties": false,
              "properties": {
                "min": { "$ref": "#/$defs/number_or_missing" },
                "max": { "$ref": "#/$defs/number_or_missing" },
                "basis": { "type": "string", "minLength": 1, "description": "Where the estimate comes from, e.g. 'provider estimate'." }
              }
            },
            "access_period": { "$ref": "#/$defs/text_or_missing" },
            "start_dates": { "$ref": "#/$defs/text_or_missing" }
          }
        },
        "ireland_access": {
          "type": "object",
          "required": ["status", "notes", "live_session_timezone"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["available", "available-with-restrictions", "not verified"] },
            "notes": { "type": "string" },
            "live_session_timezone": { "$ref": "#/$defs/text_or_missing" }
          }
        },
        "pricing": {
          "type": "object",
          "required": ["model", "advertised", "amount", "currency", "eur_approx", "additional_costs", "financial_aid"],
          "additionalProperties": false,
          "properties": {
            "model": { "enum": ["free", "free-audit", "subscription", "one-off", "publicly-funded", "mixed"] },
            "advertised": { "type": "string", "minLength": 1, "description": "Price exactly as advertised, with period and currency." },
            "amount": { "$ref": "#/$defs/number_or_missing", "description": "Headline amount in original currency (0 for free)." },
            "currency": {
              "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "$ref": "#/$defs/missing" }]
            },
            "eur_approx": {
              "description": "Generated by scripts/apply_fx.py from the top-level fx block.",
              "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/missing" }]
            },
            "additional_costs": { "$ref": "#/$defs/string_list" },
            "financial_aid": { "$ref": "#/$defs/string_list" }
          }
        },
        "learner_rating": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["published", "not published", "not verified"] },
            "platform": { "type": "string" },
            "value": { "type": "number", "minimum": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "review_count": { "type": "integer", "minimum": 0 },
            "count_type": { "enum": ["reviews", "ratings"] },
            "scope": { "type": "string", "description": "What the rating covers, e.g. 'this course' or 'aggregate of the courses in this specialization'." },
            "source_url": { "type": "string", "format": "uri" },
            "verified_on": { "$ref": "#/$defs/date" }
          },
          "if": { "properties": { "status": { "const": "published" } } },
          "then": { "required": ["platform", "value", "scale", "review_count", "count_type", "scope", "source_url", "verified_on"] }
        },
        "rating_class": {
          "description": "Checked by scripts/validate.py against learner_rating.",
          "enum": ["highly-rated", "rated-small-sample", "rated-below-threshold", "credible-but-unrated"]
        },
        "quality_evidence": { "$ref": "#/$defs/string_list", "minItems": 1 },
        "limitations": { "$ref": "#/$defs/string_list", "minItems": 1 },
        "relevance": { "type": "string", "minLength": 1 },
        "suitability": {
          "description": "The maintainer's own assessment; separate from learner ratings. score is recomputed by validate.py.",
          "type": "object",
          "required": ["score", "components", "confidence", "rationale"],
          "additionalProperties": false,
          "properties": {
            "score": { "$ref": "#/$defs/score" },
            "components": {
              "type": "object",
              "required": ["relevance", "curriculum", "practical", "quality", "value", "accessibility"],
              "additionalProperties": false,
              "properties": {
                "relevance": { "$ref": "#/$defs/score" },
                "curriculum": { "$ref": "#/$defs/score" },
                "practical": { "$ref": "#/$defs/score" },
                "quality": { "$ref": "#/$defs/score" },
                "value": { "$ref": "#/$defs/score" },
                "accessibility": { "$ref": "#/$defs/score" }
              }
            },
            "confidence": { "enum": ["high", "medium", "low"] },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "status": { "enum": ["active", "upcoming", "paused", "archived", "not verified"] },
        "archive": {
          "type": "object",
          "required": ["date", "reason"],
          "additionalProperties": false,
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "reason": { "type": "string", "minLength": 1 },
            "superseded_by": { "type": "string" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "supports", "accessed"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "supports": { "type": "string", "minLength": 1, "description": "Which facts this source supports." },
              "accessed": { "$ref": "#/$defs/date" }
            }
          }
        },
        "verification": {
          "type": "object",
          "required": ["last_verified", "method", "gaps", "conflicts"],
          "additionalProperties": false,
          "properties": {
            "last_verified": { "$ref": "#/$defs/date" },
            "method": { "enum": ["official-page-direct", "web-search-of-official-pages", "mixed"] },
            "gaps": { "$ref": "#/$defs/string_list" },
            "conflicts": { "$ref": "#/$defs/string_list" }
          }
        },
        "user": {
          "description": "Maintained by the user. Automated refreshes must never overwrite this block.",
          "type": "object",
          "required": ["completion_status", "notes"],
          "additionalProperties": false,
          "properties": {
            "completion_status": { "enum": ["not-started", "interested", "planned", "in-progress", "completed", "dropped"] },
            "notes": { "type": "string" },
            "started_on": { "$ref": "#/$defs/date" },
            "completed_on": { "$ref": "#/$defs/date" }
          }
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "change"],
            "additionalProperties": false,
            "properties": {
              "date": { "$ref": "#/$defs/date" },
              "change": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "archived" } } },
          "then": { "required": ["archive"] }
        }
      ]
    }
  }
}
